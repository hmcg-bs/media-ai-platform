# Copy to .env and fill in. Read by pipeline/config.py (pydantic-settings).

# ─── GCP ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id      # required: Vertex AI project
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1

# Amp orbs use keyless Workload Identity Federation. Configure these as Amp
# project environment variables, not local secrets. GCP_WIF_PROVIDER is the
# full provider resource beginning with projects/<numeric-project-number>/...
# AMP_GCP_AUDIENCE=urn:amp:gcp:your-gcp-project-id
# GCP_WIF_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/amp-orbs/providers/amp-provider
# GOOGLE_APPLICATION_CREDENTIALS=/home/user/workspace/repo/.amp/gcp-external-account.json
# GOOGLE_EXTERNAL_ACCOUNT_ALLOW_EXECUTABLES=1
# GCP_WIF_SERVICE_ACCOUNT=optional-sa@your-gcp-project-id.iam.gserviceaccount.com

# ─── Cognitive model tiers (Vertex AI Gemini) ─────────────────────────
GEMINI_CHEAP_MODEL=gemini-2.0-flash-lite
GEMINI_DEEP_MODEL=gemini-2.5-flash

# ─── Deterministic vision params (optional overrides) ─────────────────
# KMEANS_CLUSTERS=3
# KMEANS_PERIMETER_PCT=0.10
# MAX_IMAGE_DIMENSION_PX=1024

LOG_LEVEL=INFO

# Local trusted workstations may use `gcloud auth application-default login`.
# Orbs must use docs/gcp-orb-auth.md; never upload a service-account key.
