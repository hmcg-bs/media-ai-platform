# Copy to .env and fill in. Read by pipeline/config.py (pydantic-settings).

# ─── GCP ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id      # required: Vertex AI project
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1

# ─── Cognitive model tiers (Vertex AI Gemini) ─────────────────────────
GEMINI_CHEAP_MODEL=gemini-2.0-flash-lite
GEMINI_DEEP_MODEL=gemini-2.5-flash

# ─── Deterministic vision params (optional overrides) ─────────────────
# KMEANS_CLUSTERS=3
# KMEANS_PERIMETER_PCT=0.10
# MAX_IMAGE_DIMENSION_PX=1024

LOG_LEVEL=INFO

# Auth: run `gcloud auth application-default login` (ADC). No key path needed.
